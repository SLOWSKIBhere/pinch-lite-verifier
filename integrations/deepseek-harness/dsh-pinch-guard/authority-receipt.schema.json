{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pinch.local/schemas/authority-receipt.schema.json",
  "title": "PINCH Authority Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "receiptId",
    "runId",
    "intentDigest",
    "issuedAt",
    "expiresAt",
    "verification",
    "allowedTools",
    "maxCalls"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "receiptId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "intentDigest": {
      "type": "string",
      "minLength": 1
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "verifier", "evidence"],
      "properties": {
        "status": {
          "enum": ["PASS", "FAIL", "WITHDRAW", "UNAVAILABLE", "UNRESOLVED"]
        },
        "verifier": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "allowedTools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pathPrefixes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowUnscopedTools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "maxCalls": {
      "type": "integer",
      "minimum": 1
    }
  }
}
